# ConnectorHub API — 로컬 개발용 예시. 실제 값은 커밋하지 않는다.

# --- 사이트 인증 (AgentToolbox Site Auth 계약의 소비자) ---
# 계약 정본: AgentToolbox docs/architecture/site-auth-contract.md
# 미설정이면 인증이 필요한 라우트가 503 을 낸다(헬스체크는 뜬다).
SITE_AUTH_BASE_URL=http://localhost:8000/api/v1
# AgentToolbox 의 SITE_AUTH_SERVICE_TOKENS 에 'connector-hub:<이 값>' 으로 등록한 키.
SITE_AUTH_SERVICE_TOKEN=
# 세션 JWT 의 기대 iss — AgentToolbox 의 AUTH_ACCESS_TOKEN_ISSUER 와 같아야 한다.
SITE_AUTH_ISSUER=http://localhost
SITE_AUTH_AUDIENCE=agent-factory-site
# 계약 §4.1 권고 30~60. 짧으면 Site Auth 가 병목이 되고 길면 로그아웃 반영이 늦다.
SITE_AUTH_INTROSPECT_CACHE_SEC=45
SITE_AUTH_JWKS_CACHE_SEC=600
SITE_AUTH_TIMEOUT_SEC=2.5

# --- 데이터베이스 ---
# AgentToolbox 와 **다른** 데이터베이스다. 같은 인스턴스를 써도 되지만 같은 DB 를 가리키면
# 안 된다 — 스키마 소유권이 갈리는 것이 분리의 핵심이다.
DATABASE_URL=postgresql://connector_hub@localhost:5432/connector_hub

# --- 게이트웨이 ---
# 계약상 고정값. 바꾸면 게이트웨이 경로·Web base 와 어긋난다.
CONNECTOR_API_BASE_PATH=/connector/api/v1
